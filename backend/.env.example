# =============================================================================
# CRM Backend — Environment Variables
# =============================================================================

# App
APP_NAME="CRM Pro API"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Database (PostgreSQL)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=crm_password_change_me
POSTGRES_DB=crm_db
# DATABASE_URL is constructed in app/config.py from the above values

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# JWT / Auth
JWT_SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# MinIO (S3-compatible file storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET_NAME=crm-files
MINIO_USE_SSL=false

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# AI (future — uncomment when ready)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
# EMBEDDING_MODEL=text-embedding-ada-002

# Logging
LOG_LEVEL=INFO
