# =============================================================================
# NextCRM — Production Environment Variables
# =============================================================================
# Copy to .env and fill in real values before deploying:
#   cp .env.production.example .env
# =============================================================================

# --- Public URL (your domain or server IP) ---
# This is the URL users will access the app from.
# Examples: http://your-server-ip, https://crm.yourdomain.com
PUBLIC_URL=http://your-server-ip
PUBLIC_PORT=80

# --- Database ---
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=crm_db

# --- Redis ---
# No config needed — internal only

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
MINIO_BUCKET_NAME=crm-files

# --- Auth Secrets (REQUIRED — generate with: openssl rand -base64 32) ---
JWT_SECRET_KEY=GENERATE_ME_openssl_rand_base64_64
AUTH_SECRET=GENERATE_ME_openssl_rand_base64_32

# --- App ---
NEXT_PUBLIC_APP_NAME="CRM Pro"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
LOG_LEVEL=WARNING
