# =============================================================================
# Docker-specific environment for the Next.js frontend
# =============================================================================
# This file is bind-mounted as .env.local inside the container.
# It overrides the local .env.local so service names resolve within Docker.
# =============================================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="CRM Pro"

# Backend API — uses Docker service name, not localhost
BACKEND_API_URL=http://api:8000/api/v1

# Auth
AUTH_SECRET=docker-dev-secret-change-me-in-production
