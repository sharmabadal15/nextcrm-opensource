# =============================================================================
# NextCRM — Root Environment Variables
# =============================================================================
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
# =============================================================================

# --- Database (PostgreSQL) ---
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=crm_password_change_me
POSTGRES_DB=crm_db
POSTGRES_PORT_EXTERNAL=5433

# --- Redis ---
REDIS_PORT_EXTERNAL=6379

# --- MinIO (S3-compatible File Storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=crm-files
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Backend (FastAPI) ---
APP_NAME="CRM Pro API"
APP_ENV=development
DEBUG=true
API_PORT=8000
JWT_SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
LOG_LEVEL=INFO

# --- Frontend (Next.js) ---
FRONTEND_PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="CRM Pro"
AUTH_SECRET=generate-me-with-openssl-rand-base64-32
